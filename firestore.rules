rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "abhiramsaianil03@gmail.com" &&
        request.auth.token.email_verified == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$');
    }

    // Experts: Public read, Admin write
    match /experts/{expertId} {
      allow read: if true;
      allow write: if isAdmin(); 
    }

    // Slots: Public read, Restricted write
    match /slots/{slotId} {
      allow read: if true;
      allow create: if isAdmin();

      function isValidSlot(data) {
        return data.expertId is string && data.expertId.size() <= 128
          && data.date is string && data.date.size() <= 32
          && data.startTime is string && data.startTime.size() <= 16
          && data.isBooked is bool;
      }

      // Users can only "book" a slot if it's currently free, they are
      // signed in, and they are booking it for themselves (no impersonation).
      allow update: if (
        isSignedIn()
        && isValidSlot(request.resource.data)
        && (
          // Action: Book a slot
          (resource.data.isBooked == false && request.resource.data.isBooked == true
           && request.resource.data.bookedBy == request.auth.token.email
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBooked', 'bookedBy', 'bookingId']))
        )
      );
    }

    // Bookings: Owner-only read/write. Creation requires a signed-in user
    // booking under their own verified email address.
    match /bookings/{bookingId} {
      function isValidBooking(data) {
        return data.expertId is string && data.expertId.size() <= 128
          && data.userName is string && data.userName.size() <= 128
          && data.userEmail is string && data.userEmail.size() <= 128
          && data.date is string && data.date.size() <= 32
          && data.timeSlot is string && data.timeSlot.size() <= 32
          && data.status is string && data.status in ['Pending', 'Confirmed', 'Completed'];
      }

      allow create: if isSignedIn()
        && isValidBooking(request.resource.data)
        && request.resource.data.status == 'Confirmed'
        && request.resource.data.userEmail == request.auth.token.email;
      allow read: if isSignedIn() && resource.data.userEmail == request.auth.token.email;
      allow list: if isSignedIn()
        && request.query.limit <= 100
        && request.query.filters.userEmail == request.auth.token.email;
    }
  }
}
